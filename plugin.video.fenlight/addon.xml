<addon id="plugin.video.fenlight" name="[B]Newf's Fenlight[/B]" provider-name="newf276" version="4.1.0">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.pil" version="1.1.7"/>
        <import addon="script.module.requests" version="2.19.1"/>
		<import addon="script.module.newfsscrapers" version="4.1.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="resources/lib/fenlight.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="resources/lib/service.py"/>
    <extension point="xbmc.python.module" library="resources/lib/"/>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>true</reuselanguageinvoker>
        <summary lang="en">Access your content from premium cloud services.</summary>
        <description lang="en">Fenlight is a streamlined Kodi video addon for browsing and playing content from your own services. Discover, Search, and browse media of interest. You must own the content of any media you play through this addon.</description>
        <platform>all</platform>
		<disclaimer lang="en">The author of this addon does not host any of the content which is found and has no affiliation with any of the content providers.</disclaimer>
		<language>en</language>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
        <source>https://github.com/newf276/build/tree/master/zips</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
            <clearlogo>clearlogo.png</clearlogo>
        </assets>
    </extension>
</addon>