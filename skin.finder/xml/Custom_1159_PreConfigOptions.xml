<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1159">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>350</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight3]" />
				<param name="header_label" value="Newf's Pre-configs" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList_dialog</include>
				<onback>Dialog.Close(1159)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(Finder.DirectDialog1158),true)">ActivateWindow(1106)</onback>
				<content>
					<item>
						<label>[COLOR dodgerblue]Trakt Collection[/COLOR] (Recommended)</label>
						<onclick>Dialog.Close(All)</onclick>
						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_trakt_library)</onclick>
					</item>
					<item>
						<label>Basic</label>
						<visible>String.IsEqual(Skin.String(SelectedPreConfigAddon),fenlight)</visible>
						<onclick>ClearProperty(FENtastic.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick>RunScript(script.fentastic.helper,mode=apply_pre_config&amp;config=fenlight_basic)</onclick>
					</item>
					<item>
						<label>Trakt Watchlist</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_trakt_watchlist)</onclick>
					</item>
					<item>
						<label>TMDB Watchlist + Trakt as Tracker</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_tmdb_watchlist)</onclick>
					</item>
					<item>
						<label>TMDB Addon Only</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_tmdbaddon)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>