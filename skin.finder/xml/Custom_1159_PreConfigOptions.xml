<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1159">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>350</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight3]" />
				<param name="header_label" value="Newf's Pre-configs" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList_dialog</include>
				<onback>Dialog.Close(1159)</onback>
				<onback >ActivateWindow(1106)</onback>
				<content>
					<!-- Finder Configurations (Hidden unless Finder video add-on is installed) -->
					<item>
						<label>F-TMDB Watchlist + Trakt</label>
						<visible>System.HasAddon(plugin.video.finder)</visible>
						<onclick>ClearProperty(Finder.DirectDialog1159,home)</onclick>
						<onclick>Dialog.Close(all)</onclick><onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_tmdb_watchlist)</onclick>
					</item>
					<item>
						<label>F-Trakt Collection</label>
						<visible>System.HasAddon(plugin.video.finder)</visible>
						<onclick>ClearProperty(Finder.DirectDialog1159,home)</onclick>
						<onclick>Dialog.Close(all)</onclick><onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_trakt_library)</onclick>
					</item>
					<item>
						<label>F-Trakt Watchlist</label>
						<visible>System.HasAddon(plugin.video.finder)</visible>
						<onclick>ClearProperty(Finder.DirectDialog1159,home)</onclick>
						<onclick>Dialog.Close(all)</onclick><onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_trakt_watchlist)</onclick>
					</item>
                    
					<!-- Red Light Configurations (Hidden unless Red Light video add-on is installed) -->
					<item>
						<label>RL-TMDB Watchlist + Trakt</label>
						<visible>System.HasAddon(plugin.video.redlight)</visible>
						<onclick>ClearProperty(Finder.DirectDialog1159,home)</onclick>
						<onclick>Dialog.Close(all)</onclick>						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=red_light_tmdb_watchlist)</onclick>
					</item>
					<item>
						<label>RL-Trakt Collection</label>
						<visible>System.HasAddon(plugin.video.redlight)</visible>
						<onclick>ClearProperty(Finder.DirectDialog1159,home)</onclick>
						<onclick>Dialog.Close(all)</onclick>						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=red_light_trakt_library)</onclick>
					</item>
					<item>
						<label>RL-Trakt Watchlist</label>
						<visible>System.HasAddon(plugin.video.redlight)</visible>
						<onclick>ClearProperty(Finder.DirectDialog1159,home)</onclick>
						<onclick>Dialog.Close(all)</onclick><onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=red_light_trakt_watchlist)</onclick>
					</item> 
				</content>
			</control>
		</control>
	</controls>
</window>
