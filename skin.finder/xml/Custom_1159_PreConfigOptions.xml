<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1159">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>350</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight3]" />
				<param name="header_label" value="Newf's Pre-configs" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList_dialog</include>
				<onback>Dialog.Close(1159)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(Finder.DirectDialog1158),true)">ActivateWindow(1106)</onback>
				<content>
					<!-- The Finder -->
					<item>
						<label>Finder: Trakt Collection</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick condition="System.AddonIsEnabled(plugin.video.finder)">RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_trakt_library)</onclick>
						<onclick condition="System.HasAddon(plugin.video.finder) + !System.AddonIsEnabled(plugin.video.finder)">EnableAddon(plugin.video.finder)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.finder)">InstallAddon(plugin.video.finder)</onclick>
					</item>
					<item>
						<label>Finder: Trakt Watchlist</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick condition="System.AddonIsEnabled(plugin.video.finder)">RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_trakt_watchlist)</onclick>
						<onclick condition="System.HasAddon(plugin.video.finder) + !System.AddonIsEnabled(plugin.video.finder)">EnableAddon(plugin.video.finder)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.finder)">InstallAddon(plugin.video.finder)</onclick>
					</item>
					<item>
						<label>Finder: TMDB Watchlist + Trakt</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.finder)">InstallAddon(plugin.video.finder)</onclick>
						<onclick condition="System.HasAddon(plugin.video.finder) + !System.AddonIsEnabled(plugin.video.finder)">EnableAddon(plugin.video.finder)</onclick>
						<onclick condition="System.AddonIsEnabled(plugin.video.finder)">RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_tmdb_watchlist)</onclick>
					</item>
					<!-- Red Light -->
					<item>
						<label>Red Light: MDBlist Collection</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick condition="System.AddonIsEnabled(plugin.video.redlight)">RunScript(script.finder.helper,mode=apply_pre_config&amp;config=red_light_mdblist_library)</onclick>
						<onclick condition="System.HasAddon(plugin.video.redlight) + !System.AddonIsEnabled(plugin.video.redlight)">EnableAddon(plugin.video.redlight)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.redlight)">InstallAddon(plugin.video.redlight)</onclick>
						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=red_light_mdblist_library)</onclick>
					</item>
					<item>
						<label>Red Light: MDBlist Watchlist</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick condition="System.AddonIsEnabled(plugin.video.redlight)">RunScript(script.finder.helper,mode=apply_pre_config&amp;config=red_light_mdblist_watchlist)</onclick>
						<onclick condition="System.HasAddon(plugin.video.redlight) + !System.AddonIsEnabled(plugin.video.redlight)">EnableAddon(plugin.video.redlight)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.redlight)">InstallAddon(plugin.video.redlight)</onclick>
					</item>
					<item>
						<label>Red Light: Trakt Library</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick condition="System.AddonIsEnabled(plugin.video.redlight)">RunScript(script.finder.helper,mode=apply_pre_config&amp;config=red_light_trakt_library)</onclick>
						<onclick condition="System.HasAddon(plugin.video.redlight) + !System.AddonIsEnabled(plugin.video.redlight)">EnableAddon(plugin.video.redlight)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.redlight)">InstallAddon(plugin.video.redlight)</onclick>
					</item>
					<item>
						<label>Redlight: Trakt Watchlist</label>
						<onclick>ClearProperty(Finder.DirectDialog1158,home)</onclick>
						<onclick>Dialog.Close(1159)</onclick>
						<onclick condition="System.AddonIsEnabled(plugin.video.redlight)">RunScript(script.finder.helper,mode=apply_pre_config&amp;config=red_light_trakt_watchlist)</onclick>
						<onclick condition="System.HasAddon(plugin.video.redlight) + !System.AddonIsEnabled(plugin.video.redlight)">EnableAddon(plugin.video.redlight)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.redlight)">InstallAddon(plugin.video.redlight)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
