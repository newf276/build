<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1111">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>350</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight3]" />
				<param name="header_label" value="Authorize Services" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList_dialog</include>
				<onback>Dialog.Close(1111)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(Finder.DirectDialog1111),true)">ActivateWindow(1106)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1111),true)">ActivateWindow(1170)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1111),true)">ClearProperty(Finder.DirectDialog1111,home)</onback>
				<content>
					<item>
						<label>MDB List</label>
						<visible>true</visible>
						<onclick>Dialog.Close(1111)</onclick>
						<onclick>ActivateWindow(1117)</onclick>
					</item>
					<item>
						<label>Trakt</label>
						<visible>!Skin.HasSetting(AuthNoTrakt)</visible>
						<onclick>Dialog.Close(1111)</onclick>
						<onclick>ActivateWindow(1108)</onclick>
					</item>
					<item>
						<label>TMDB</label>
						<visible>true</visible>
						<onclick>Dialog.Close(1111)</onclick>
						<onclick>ActivateWindow(1113)</onclick>
					</item>
					<item>
						<label>All-Debrid</label>
						<visible>!Skin.HasSetting(AuthNoAllDebrid)</visible>
						<onclick>Dialog.Close(1111)</onclick>
						<onclick>ActivateWindow(1115)</onclick>
					</item>
					<item>
						<label>Premiumize</label>
						<visible>!Skin.HasSetting(AuthNoPremiumize)</visible>
						<onclick>Dialog.Close(1111)</onclick>
						<onclick>ActivateWindow(1114)</onclick>
					</item>
					<item>
						<label>Torbox</label>
						<visible>!Skin.HasSetting(AuthNoTorbox)</visible>
						<onclick>Dialog.Close(1111)</onclick>
						<onclick>ActivateWindow(1116)</onclick>
					</item>
				</content>
			</control>
			<include content="UpDownArrows">
				<param name="container_id" value="9000" />
				<param name="posx" value="276" />
				<param name="up_posy" value="-35" />
				<param name="down_posy" value="360" />
			</include>
		</control>
	</controls>
</window>
