<?xml version='1.0' encoding='UTF-8'?>
<includes>
    <include name="TVShowsMainMenu">
        <item>
            <label>TV Shows</label>
            <onclick condition="String.IsEqual(Skin.String(FinderHomePreset),punchplay_collection)">ActivateWindow(10025,plugin://plugin.video.finder/?action=punchplay_collection&amp;category_name=PunchPlay+TV+Collection&amp;mode=build_tvshow_list,return)</onclick>
            <onclick condition="String.IsEqual(Skin.String(FinderHomePreset),punchplay_watchlist)">ActivateWindow(10025,plugin://plugin.video.finder/?action=punchplay_watchlist&amp;category_name=PunchPlay+TV+Watchlist&amp;mode=build_tvshow_list,return)</onclick>
            <onclick condition="String.IsEqual(Skin.String(FinderHomePreset),tmdb_watchlist)">ActivateWindow(10025,plugin://plugin.video.finder/?list_id=watchlist&amp;list_name=TV+Show+Watchlist&amp;media_type=tv&amp;mode=tmdblist.build_tmdb_list,return)</onclick>
            <onclick condition="String.IsEqual(Skin.String(FinderHomePreset),trakt_collection)">ActivateWindow(10025,plugin://plugin.video.finder/?action=trakt_collection&amp;category_name=TV+Shows+Collection&amp;mode=build_tvshow_list,return)</onclick>
            <onclick condition="String.IsEqual(Skin.String(FinderHomePreset),trakt_watchlist)">ActivateWindow(10025,plugin://plugin.video.finder/?action=trakt_watchlist&amp;category_name=TV+Shows+Watchlist&amp;mode=build_tvshow_list,return)</onclick>
            <onclick condition="String.IsEmpty(Skin.String(FinderHomePreset))">ActivateWindow(10025,plugin://plugin.video.finder/?name=TV+Shows&amp;iconImage=tv&amp;mode=navigator.main&amp;action=TVShowList,return)</onclick>
            <property name="menu_id">$NUMBER[22000]</property>
            <thumb>icons/sidemenu/tv.png</thumb>
            <property name="id">tvshows</property>
            <visible>!Skin.HasSetting(HomeMenuNoTVShowsButton)</visible>
        </item>
    </include>
</includes>