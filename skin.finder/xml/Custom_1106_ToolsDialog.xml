<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1106">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>350</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight3]" />
				<param name="header_label" value="Maintenance & Tools" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList_dialog</include>
				<content>
                    <item>
						<label>[COLOR limegreen]Newf's Pre-Made Trakt[/COLOR]</label>
                        <onclick>Dialog.Close(all)</onclick>
						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_trakt)</onclick>
                    </item>
                    <item>
						<label>[COLOR darkgoldenrod]Newf's Pre-Made TMDB[/COLOR]</label>
                        <onclick>Dialog.Close(all)</onclick>
						<onclick>RunScript(script.finder.helper,mode=apply_pre_config&amp;config=finder_tmdb)</onclick>
                    </item>
                    <item>
                        <label>Reload Skin</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ReloadSkin()</onclick>
                    </item>
                    <item>
                        <label>Authorize Services</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(1111)</onclick>
                    </item>
                    <item>
                        <label>Backup & Restore</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick condition="System.AddonIsEnabled(plugin.program.cleaner)">ActivateWindow(10001,"plugin://plugin.program.cleaner/?description=Backup%20and%20Restore%20Build%5b%2fB%5d&amp;kodi&amp;mode=12&amp;name=Backup%2fRestore%20Build%5b%2fB%5d&amp;name2&amp;url&amp;version",return)</onclick>
                        <onclick condition="System.HasAddon(plugin.program.cleaner) + !System.AddonIsEnabled(plugin.program.cleaner)">EnableAddon(plugin.program.cleaner)</onclick>
                        <onclick condition="!System.HasAddon(plugin.program.cleaner)">InstallAddon(plugin.program.cleaner)</onclick>
                    </item>
                    <item>
                        <label>Clear Finder Cache</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick condition="System.AddonIsEnabled(plugin.video.finder)">RunPlugin(plugin://plugin.video.finder/?mode=clear_all_cache)</onclick>
                    </item>
                    <item>
                        <label>Clear Kodi Caches</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.program.cleaner?mode=33)</onclick>
                    </item>
                    <item>
                        <label>Clear Thumbnails</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunScript(script.finder.helper,mode=clear_thumbnails)</onclick>
                    </item>
                    <item>
                        <label>Network Speed Test</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.program.cleaner/?mode=28)</onclick>
                    </item>
                    <item>
                        <label>Newf's Wizard</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(10001,"plugin://plugin.program.cleaner",return)</onclick>
                    </item>
                    <item>
                        <label>Finder Settings</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.video.finder/?mode=open_settings)</onclick>
                    </item>
                    <item>
                        <label>Skin Settings</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(SkinSettings)</onclick>
                    </item>
					<item>
						<label>Video Cache Config</label>
						<visible>!Skin.HasSetting(ToolsNoVideoCacheConfig)</visible>
						<onclick>Dialog.Close(all)</onclick>
						<onclick>RunScript(script.finder.helper,mode=advanced_set)</onclick>
					</item>
                    <item>
                        <label>System Information</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(systeminfo)</onclick>
                    </item>
				</content>
			</control>
			<include content="UpDownArrows">
				<param name="container_id" value="9000" />
				<param name="posx" value="276" />
				<param name="up_posy" value="-35" />
				<param name="down_posy" value="360" />
			</include>
		</control>
	</controls>
</window>
