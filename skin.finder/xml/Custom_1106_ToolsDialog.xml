<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1106">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>350</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight3]" />
				<param name="header_label" value="Maintenance &amp; Tools" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList_dialog</include>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1106),true)">Dialog.Close(1106)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1106),true)">ActivateWindow(1170)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1106),true)">ClearProperty(Finder.DirectDialog1106,home)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(Finder.DirectDialog1106),true)">Dialog.Close(1106)</onback>
				<content>
					<item>
    				    <label>Newf's Pre-Made Configs</label>
    				    <visible>True</visible>
    				    <onclick>Dialog.Close(1106)</onclick>
    				<onclick>RunScript(script.finder.helper,mode=pre_config)</onclick>
					</item> 
                    <item>
                        <label>Newf's Authorize Services</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(1111)</onclick>
                    </item>
                    <item>
                        <label>Reload Skin</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ReloadSkin()</onclick>
                    </item>
					<item>
						<label>Video Cache Configs</label>
						<visible>!Skin.HasSetting(ToolsNoVideoCacheConfig)</visible>
						<onclick>Dialog.Close(all)</onclick>
						<onclick>RunScript(script.finder.helper,mode=advanced_set)</onclick>
					</item>
                    <item>
                        <label>Network Speed Test</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.program.cleaner/?mode=28)</onclick>
                    </item>
                    <item>
                        <label>Clear Finder Caches</label>
                        <onclick>Dialog.Close(all)</onclick>
						<onclick>RunPlugin(plugin://plugin.video.finder/?mode=clear_all_cache)</onclick>
                    </item>
                    <item>
                        <label>Clear Kodi Caches</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.program.cleaner?mode=33)</onclick>
                    </item>
                    <item>
                        <label>Clear Thumbnails</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunScript(script.finder.helper,mode=clear_thumbnails)</onclick>
                    </item>
                    <item>
                        <label>Newf's Wizard</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(10001,"plugin://plugin.program.cleaner",return)</onclick>
                    </item>
                    <item>
                        <label>Backup Configuration</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunScript(script.finder.helper,mode=backup_config)</onclick>
                    </item>
                    <item>
                        <label>Restore Configuration</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunScript(script.finder.helper,mode=restore_config)</onclick>
                    </item>
                    <item>
                        <label>Import Configuration</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunScript(script.finder.helper,mode=import_config)</onclick>
                    </item>
                    <item>
                        <label>Export Configuration</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunScript(script.finder.helper,mode=export_config)</onclick>
                    </item>
                    <item>
                        <label>Backup/Restore Local Newf's Builds</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(10001,"plugin://plugin.program.cleaner/?description=Backup+and+Restore+Build&kodi&mode=12&name=Backup/Restore Build&name2&url&version",return)</onclick>
                    </item>
				</content>
			</control>
			<include content="UpDownArrows">
				<param name="container_id" value="9000" />
				<param name="posx" value="276" />
				<param name="up_posy" value="-35" />
				<param name="down_posy" value="360" />
			</include>
		</control>
	</controls>
</window>
