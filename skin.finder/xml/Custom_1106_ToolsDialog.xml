<?xml version='1.0' encoding='UTF-8'?>
<window type="dialog" id="1106">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>770</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600"/>
				<param name="height" value="770"/>
				<param name="header_label" value="Tools"/>
				<param name="header_id" value=""/>
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png"/>
			</include>
			<control type="panel" id="9000">
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="630"/>
				</include>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1106),true)">Dialog.Close(1106)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1106),true)">ActivateWindow(1106)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1106),true)">ClearProperty(Finder.DirectDialog1106,home)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(Finder.DirectDialog1106),true)">Dialog.Close(1106)</onback>
				<content>
                    <item>
                        <label>Pre-Config</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(1159)</onclick>
                    </item>
                    <item>
                        <label>Authorize Services</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(1111)</onclick>
                    </item>
                    <item>
                        <label>Newf's Wizard</label>
                        <visible>System.AddonIsEnabled(plugin.program.cleaner)</visible>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ActivateWindow(10001,"plugin://plugin.program.cleaner",return)</onclick>
                    </item>
                    <item>
                        <label>Network Speed Test</label>
                        <visible>System.AddonIsEnabled(plugin.program.cleaner)</visible>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.program.cleaner/?mode=28)</onclick>
                    </item>
                    <item>
                        <label>Clear Kodi Caches</label>
                        <visible>System.AddonIsEnabled(plugin.program.cleaner)</visible>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.program.cleaner?mode=33)</onclick>
                    </item>
                    <item>
                        <label>Clear Newf's Finder Caches</label>
                        <visible>System.AddonIsEnabled(plugin.video.finder)</visible>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.video.finder/?mode=clear_all_cache)</onclick>
                    </item>
                    <item>
                        <label>[COLOR yellow]Reset Finder Settings to Defaults[/COLOR]</label>
                        <visible>System.AddonIsEnabled(plugin.video.finder)</visible>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.video.finder/?mode=settings_manager.reset_settings_keep_accounts)</onclick>
                    </item>
                    <item>
                        <label>[COLOR red]Factory Reset Finder[/COLOR]</label>
                        <visible>System.AddonIsEnabled(plugin.video.finder)</visible>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>RunPlugin(plugin://plugin.video.finder/?mode=settings_manager.reset_addon_data)</onclick>
                    </item>
                    <item>
                        <label>Reload Skin</label>
                        <onclick>Dialog.Close(all)</onclick>
                        <onclick>ReloadSkin()</onclick>
                    </item>
                </content>
			</control>
			<include content="UpDownArrows">
				<param name="container_id" value="9000"/>
				<param name="posx" value="276"/>
				<param name="up_posy" value="-35"/>
				<param name="down_posy" value="780"/>
			</include>
		</control>
	</controls>
</window>