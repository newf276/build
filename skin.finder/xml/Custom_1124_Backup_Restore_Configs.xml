<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1124">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>350</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight3]" />
				<param name="header_label" value="Backup & Restore Configs" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList_dialog</include>
				<onback>Dialog.Close(1124)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1124),true)">ActivateWindow(1170)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1124),true)">ClearProperty(Finder.DirectDialog1124,home)</onback>
				<onback condition="!String.IsEqual(Window(Home).Property(Finder.DirectDialog1124),true)">ActivateWindow(1126)</onback>
				<content>
					<item>
						<label>Backup Config</label>
						<onclick>Dialog.Close(1124)</onclick>
						<onclick>RunScript(script.finder.helper,mode=backup_config)</onclick>
					</item>
					<item>
						<label>Restore Config</label>
						<onclick>Dialog.Close(1124)</onclick>
						<onclick>RunScript(script.finder.helper,mode=restore_config)</onclick>
					</item>
					<item>
						<label>Set Backup Directory</label>
						<onclick>Dialog.Close(1124)</onclick>
						<onclick>ActivateWindowAndFocus(skinsettings,9000,3,63706,0)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
