<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1156">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>350</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight3]" />
				<param name="header_label" value="Backup &amp; Restore" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList_dialog</include>
				<onback>Dialog.Close(1156)</onback>
				<onback>ActivateWindow(1123)</onback>
				<content>
					<item>
						<label>Backup GUI Settings</label>
						<onclick>Dialog.Close(1156)</onclick>
						<onclick>RunScript(script.finder.helper,mode=backup_gui)</onclick>
					</item>
					<item>
						<label>Restore GUI Settings</label>
						<onclick>Dialog.Close(1156)</onclick>
						<onclick>RunScript(script.finder.helper,mode=restore_gui)</onclick>
					</item>
					<item>
						<label>Restore Default GUI Settings</label>
						<onclick>Dialog.Close(1156)</onclick>
						<onclick>RunScript(script.finder.helper,mode=restore_gui_dflt)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
