<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1107">
	<defaultcontrol>9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>700</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight8]" />
				<param name="header_label" value="$LOCALIZE[137] [COLOR accent_color][B]($VAR[CurrentSearchProviderVar])[/B][/COLOR]" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<onback>Dialog.Close(1107)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1107),true)">ActivateWindow(1170)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1107),true)">ClearProperty(Finder.DirectDialog1107,home)</onback>
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="560" />
				</include>
				<content>
					<item>
						<label>$VAR[KeywordMoviesLabelVar]</label>
						<onclick>Dialog.Close(1107)</onclick>
						<onclick condition="String.IsEqual(Skin.String(current_search_provider),5)">ActivateWindow(Videos,"plugin://plugin.video.finder/?action=tmdb_keyword_movie&amp;mode=navigator.search_history&amp;name=Keywords%20(Movies)",return)</onclick>
					</item>
					<item>
						<label>$VAR[KeywordTVShowsLabelVar]</label>
						<onclick>Dialog.Close(1107)</onclick>
						<onclick condition="String.IsEqual(Skin.String(current_search_provider),5)">ActivateWindow(Videos,"plugin://plugin.video.finder/?action=tmdb_keyword_tvshow&amp;mode=navigator.search_history&amp;name=Keywords%20(TV%20Shows)",return)</onclick>
					</item>
					<item>
						<label>Actors/Actresses</label>
						<onclick>Dialog.Close(all)</onclick>
						<onclick condition="String.IsEqual(Skin.String(current_search_provider),5)">ActivateWindow(Videos,"plugin://plugin.video.finder/?action=people&amp;mode=navigator.search_history&amp;name=People",return)</onclick>
					</item>
				</content>
			</control>
			<include content="UpDownArrows">
				<param name="container_id" value="9000" />
				<param name="posx" value="276" />
				<param name="up_posy" value="-40" />
				<param name="down_posy" value="710" />
			</include>
		</control>
	</controls>
</window>