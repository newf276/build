<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1107">
	<defaultcontrol>9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>700</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight8]" />
				<param name="header_label" value="$LOCALIZE[137]" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<onback>Dialog.Close(1107)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1107),true)">ActivateWindow(1106)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Finder.DirectDialog1107),true)">ClearProperty(Finder.DirectDialog1107,home)</onback>
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="560" />
				</include>
				<content>
					<!-- Finder movie search -->
					<item>
						<label>Movies</label>
						<onclick>Dialog.Close(1107)</onclick>
						<onclick>ActivateWindow(Videos,"plugin://plugin.video.finder/?action=movie&amp;mode=navigator.search_history&amp;name=Movies",return)</onclick>
					</item>

					<!-- Finder TV search -->
					<item>
						<label>TV Shows</label>
						<onclick>Dialog.Close(1107)</onclick>
						<onclick>ActivateWindow(Videos,"plugin://plugin.video.finder/?action=tvshow&amp;mode=navigator.search_history&amp;name=TV%20Shows",return)</onclick>
					</item>

					<!-- Finder People search: opens the keyboard immediately -->
					<item>
						<label>Actors/Actresses</label>
						<onclick>Dialog.Close(1107)</onclick>
						<onclick>RunPlugin(plugin://plugin.video.finder/?mode=search.get_key_id&amp;search_type=people)</onclick>
					</item>

					<!-- Finder keyword searches -->
					<item>
						<label>Keywords</label>
						<onclick>Dialog.Close(1107)</onclick>
						<onclick>ActivateWindow(1171)</onclick>
					</item>

					<!-- Finder Trakt list search -->
					<item>
						<label>Trakt Lists</label>
						<onclick>Dialog.Close(1107)</onclick>
						<onclick>ActivateWindow(10025,"plugin://plugin.video.finder/?action=trakt_lists&amp;mode=navigator.search_history",return)</onclick>
					</item>

					<!-- Finder My Lists shortcut -->
					<item>
						<label>My Lists</label>
						<onclick>Dialog.Close(1107)</onclick>
						<onclick>ActivateWindow(10025,"plugin://plugin.video.finder/?&amp;mode=navigator.my_content&amp;name=My%20Lists",return)</onclick>
					</item>
				</content>
			</control>
			<include content="UpDownArrows">
				<param name="container_id" value="9000" />
				<param name="posx" value="276" />
				<param name="up_posy" value="-40" />
				<param name="down_posy" value="710" />
			</include>
		</control>
	</controls>
</window>
