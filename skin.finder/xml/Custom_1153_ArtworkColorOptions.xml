<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1153">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<onunload>Skin.Reset(Finder.PendingLookFeel)</onunload>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>420</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600"/>
				<param name="height" value="$VAR[DialogHeight4]"/>
				<param name="header_label" value="Customize Preset"/>
				<param name="header_id" value=""/>
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png"/>
			</include>
			<control type="panel" id="9000">
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="280" />
				</include>
				<onback>Dialog.Close(1153)</onback>
				<onback>ActivateWindow(1152)</onback>
				<content>
					<item>
						<label>Reset Artwork &amp; Color</label>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),fenplus)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=fenplus&amp;keep_artwork=false&amp;keep_color=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),hybrid)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=hybrid&amp;keep_artwork=false&amp;keep_color=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),cinema)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=cinema&amp;keep_artwork=false&amp;keep_color=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),classic)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=classic&amp;keep_artwork=false&amp;keep_color=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),estuary)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=estuary&amp;keep_artwork=false&amp;keep_color=false)</onclick>
						<onclick>ClearProperty(Finder.DirectDialog1152,home)</onclick>
						<onclick>Dialog.Close(1153)</onclick>
					</item>
					<item>
						<label>Keep Current Artwork</label>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),fenplus)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=fenplus&amp;keep_artwork=true&amp;keep_color=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),hybrid)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=hybrid&amp;keep_artwork=true&amp;keep_color=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),cinema)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=cinema&amp;keep_artwork=true&amp;keep_color=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),classic)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=classic&amp;keep_artwork=true&amp;keep_color=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),estuary)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=estuary&amp;keep_artwork=true&amp;keep_color=false)</onclick>
						<onclick>ClearProperty(Finder.DirectDialog1152,home)</onclick>
						<onclick>Dialog.Close(1153)</onclick>
					</item>
					<item>
						<label>Keep Current Color</label>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),fenplus)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=fenplus&amp;keep_artwork=false&amp;keep_color=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),hybrid)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=hybrid&amp;keep_artwork=false&amp;keep_color=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),cinema)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=cinema&amp;keep_artwork=false&amp;keep_color=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),classic)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=classic&amp;keep_artwork=false&amp;keep_color=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),estuary)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=estuary&amp;keep_artwork=false&amp;keep_color=true)</onclick>
						<onclick>ClearProperty(Finder.DirectDialog1152,home)</onclick>
						<onclick>Dialog.Close(1153)</onclick>
					</item>
					<item>
						<label>Keep Current Artwork &amp; Color</label>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),fenplus)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=fenplus&amp;keep_artwork=true&amp;keep_color=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),hybrid)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=hybrid&amp;keep_artwork=true&amp;keep_color=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),cinema)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=cinema&amp;keep_artwork=true&amp;keep_color=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),classic)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=classic&amp;keep_artwork=true&amp;keep_color=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Finder.PendingLookFeel),estuary)">RunScript(script.finder.helper,mode=apply_lookfeel&amp;lookfeel=estuary&amp;keep_artwork=true&amp;keep_color=true)</onclick>
						<onclick>ClearProperty(Finder.DirectDialog1152,home)</onclick>
						<onclick>Dialog.Close(1153)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
