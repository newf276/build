<?xml version="1.0" encoding="UTF-8"?>
<includes>
    <include name="TVShowWidgets">
        <include condition="System.HasAddon(plugin.video.finder)" content="WidgetListCategory">
            <param name="content_path" value="plugin://plugin.video.finder/?name=Genres&amp;iconImage=genres&amp;mode=navigator.genres&amp;menu_type=tvshow&amp;random_support=true"/>
            <param name="widget_header" value="Genres"/>
            <param name="widget_target" value="videos"/>
            <param name="list_id" value="22011"/>
        </include>
        <include condition="System.HasAddon(plugin.video.finder)" content="WidgetListBigEpisodes">
            <param name="content_path" value="plugin://plugin.video.finder/?action=trakt_collection&amp;category_name=TV+Shows+Library&amp;mode=build_tvshow_list"/>
            <param name="widget_header" value="My Trakt Show Collection"/>
            <param name="widget_target" value="videos"/>
            <param name="list_id" value="22014"/>
        </include>
        <include condition="System.HasAddon(plugin.video.cbcgem)" content="WidgetListCategory">
            <param name="content_path" value="plugin://plugin.video.cbcgem"/>
            <param name="widget_header" value="CBC Gem"/>
            <param name="widget_target" value="videos"/>
            <param name="list_id" value="22016"/>
        </include>
    </include>
</includes>