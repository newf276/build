<?xml version='1.0' encoding='UTF-8'?>
<window>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="80000000">finder_common/white.png</texture>
        </control>
        <control type="group">
            <left>280</left>
            <top>50</top>
            <control type="group">
                <control type="image">
                    <width>1362</width>
                    <height>982</height>
                    <texture colordiffuse="unfocused_text">special://skin/media/masks/landscape-502.png</texture>
                    <left>-2</left>
                    <top>-2</top>
                </control>
                <control type="image">
                    <width>1358</width>
                    <height>978</height>
                    <texture colordiffuse="dialog_bg">special://skin/media/masks/landscape-502.png</texture>
                </control>
                <control type="image">
                    <description>Kodi corner icon</description>
                    <left>1280</left>
                    <top>25</top>
                    <width>48</width>
                    <height>48</height>
                    <aspectratio>keep</aspectratio>
                    <texture colordiffuse="accent_color">special://xbmc/media/vendor_icon.png</texture>
                </control>
                <control type="label">
                    <top>40</top>
                    <left>130</left>
                    <width max="1090">auto</width>
                    <height>20</height>
                    <font>font14</font>
                    <!-- Finder_33 -->
                    <textcolor>unfocused_text</textcolor>
                    <shadowcolor>FF000000</shadowcolor>
                    <align>center</align>
                    <aligny>center</aligny>
                    <label>[B]$INFO[Window.Property(heading)][/B]</label>
                </control>
                <control type="textbox" id="2000">
                    <visible>String.IsEqual(Window.Property(font_size),small)</visible>
                    <left>30</left>
                    <top>95</top>
                    <width>1285</width>
                    <height>845</height>
                    <font>font12</font>
                    <!-- Finder_26 -->
                    <textcolor>unfocused_text</textcolor>
                    <label>$INFO[Window.Property(text)]</label>
                    <pagecontrol>2060</pagecontrol>
                    <autoscroll>false</autoscroll>
                </control>
                <control type="textbox" id="2000">
                    <visible>String.IsEqual(Window.Property(font_size),large)</visible>
                    <left>30</left>
                    <top>95</top>
                    <width>1285</width>
                    <height>845</height>
                    <font>font14</font>
                    <!-- Finder_33 -->
                    <textcolor>unfocused_text</textcolor>
                    <label>$INFO[Window.Property(text)]</label>
                    <pagecontrol>2061</pagecontrol>
                    <autoscroll>false</autoscroll>
                </control>
                <control type="scrollbar" id="2060">
                    <visible>String.IsEqual(Window.Property(font_size),small)</visible>
                    <left>1335</left>
                    <top>110</top>
                    <width>10</width>
                    <height>820</height>
                    <texturesliderbackground colordiffuse="focused_text">finder_common/white.png</texturesliderbackground>
                    <texturesliderbar colordiffuse="dialog_bg2">finder_common/white.png</texturesliderbar>
                    <texturesliderbarfocus colordiffuse="unfocused_text">finder_common/white.png</texturesliderbarfocus>
                    <onleft>2060</onleft>
                    <onright>2060</onright>
                    <showonepage>false</showonepage>
                    <orientation>vertical</orientation>
                </control>
                <control type="scrollbar" id="2061">
                    <visible>String.IsEqual(Window.Property(font_size),large)</visible>
                    <left>1335</left>
                    <top>110</top>
                    <width>10</width>
                    <height>820</height>
                    <texturesliderbackground colordiffuse="focused_text">finder_common/white.png</texturesliderbackground>
                    <texturesliderbar colordiffuse="dialog_bg2">finder_common/white.png</texturesliderbar>
                    <texturesliderbarfocus colordiffuse="unfocused_text">finder_common/white.png</texturesliderbarfocus>
                    <onleft>2061</onleft>
                    <onright>2061</onright>
                    <showonepage>false</showonepage>
                    <orientation>vertical</orientation>
                </control>
            </control>
        </control>
    </controls>
</window>
