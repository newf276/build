<?xml version='1.0' encoding='UTF-8'?>
<window>
    <defaultcontrol always="true">10</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="80000000">finder_common/white.png</texture>
        </control>
        <control type="group">
            <left>570</left>
            <top>300</top>
            <control type="image">
                <height>482</height>
                <width>782</width>
                <texture colordiffuse="unfocused_text">special://skin/media/masks/dialogconfirm.png</texture>
                <left>-2</left>
                <top>-2</top>
            </control>
            <control type="image">
                <height>478</height>
                <width>778</width>
                <texture colordiffuse="dialog_bg">special://skin/media/masks/dialogconfirm.png</texture>
            </control>
            <control type="image">
                <description>Kodi corner icon</description>
                <left>700</left>
                <top>25</top>
                <width>48</width>
                <height>48</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="accent_color">special://xbmc/media/vendor_icon.png</texture>
            </control>
            <control type="label">
                <width>640</width>
                <top>20</top>
                <left>30</left>
                <height>40</height>
                <font>font12</font>
                <!-- Finder_26 -->
                <textcolor>unfocused_text</textcolor>
                <align>center</align>
                <label>[UPPERCASE][B]$INFO[Window.Property(heading)][/B][/UPPERCASE]</label>
            </control>
            <control type="textbox">
                <left>30</left>
                <top>90</top>
                <width>718</width>
                <height>260</height>
                <font>font13</font>
                <!-- Finder_30 -->
                <textcolor>unfocused_text</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label>$INFO[Window.Property(text)]</label>
            </control>
            <control type="button" id="10">
                <description>OK</description>
                <top>380</top>
                <left>220</left>
                <width>340</width>
                <height>70</height>
                <onleft>11</onleft>
                <onright>11</onright>
                <label>$INFO[Window.Property(ok_label)]</label>
                <font>font12</font>
                <!-- Finder_26 -->
                <textcolor>unfocused_text</textcolor>
                <focusedcolor>focused_text</focusedcolor>
                <texturefocus colordiffuse="button_focus">special://skin/media/buttons/dfo.png</texturefocus>
                <texturenofocus colordiffuse="button_focus2">special://skin/media/buttons/dnfo.png</texturenofocus>
                <align>center</align>
                <aligny>center</aligny>
            </control>
        </control>
    </controls>
</window>
