<?xml version='1.0' encoding='UTF-8'?>
<window>
    <controls>
        <!-- Background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="80000000">finder_common/white.png</texture>
        </control>
        <!-- Filter Window -->
        <control type="group">
            <top>72</top>
            <left>92</left>
            <control type="image">
                <width>1736</width>
                <height>940</height>
                <texture colordiffuse="unfocused_text">special://skin/media/masks/landscape-502.png</texture>
                <left>-2</left>
                <top>-2</top>
            </control>
            <control type="image">
                <width>1732</width>
                <height>936</height>
                <texture colordiffuse="dialog_bg">special://skin/media/masks/landscape-502.png</texture>
            </control>
            <control type="image">
                <description>Kodi corner icon</description>
                <left>1654</left>
                <top>25</top>
                <width>48</width>
                <height>48</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="accent_color">special://xbmc/media/vendor_icon.png</texture>
            </control>
            <control type="label">
                <width max="1635">auto</width>
                <top>12</top>
                <left>30</left>
                <height>20</height>
                <font>font12</font>
                <!-- Finder_26 -->
                <textcolor>unfocused_text</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <align>center</align>
                <label>[UPPERCASE][B]DISCOVER[/B][/UPPERCASE]</label>
            </control>
            <control type="image">
                <left>1302</left>
                <top>360</top>
                <width max="420">auto</width>
                <aspectratio aligny="top">keep</aspectratio>
                <texture diffuse="finder_diffuse/poster-50.png" background="true">$INFO[Container(2100).ListItem.Property(icon)]</texture>
                <fadetime>100</fadetime>
            </control>
            <!-- Filter List -->
            <control type="fixedlist" id="2100">
                <pagecontrol>4100</pagecontrol>
                <left>15</left>
                <top>65</top>
                <width>1242</width>
                <height>720</height>
                <onup>2100</onup>
                <ondown>2100</ondown>
                <onleft condition="String.IsEqual(Window.Property(active_attributes),true)">10</onleft>
                <onleft condition="!String.IsEqual(Window.Property(active_attributes),true)">11</onleft>
                <onright>4100</onright>
                <scrolltime tween="sine">350</scrolltime>
                <orientation>Vertical</orientation>
                <focusposition>3</focusposition>
                <movement>4</movement>
                <scrolltime tween="sine">200</scrolltime>
                <itemlayout height="90" width="1242">
                    <control type="label">
                        <width max="360">auto</width>
                        <left>15</left>
                        <top>45</top>
                        <height>5</height>
                        <font>font12</font>
                        <!-- Finder_26 -->
                        <textcolor>unfocused_text</textcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                        <label>[UPPERCASE]$INFO[ListItem.Property(label1)][/UPPERCASE]</label>
                    </control>
                    <control type="label">
                        <width max="782">auto</width>
                        <left>440</left>
                        <top>45</top>
                        <height>5</height>
                        <font>font12</font>
                        <!-- Finder_26 -->
                        <textcolor>unfocused_text</textcolor>
                        <align>right</align>
                        <aligny>center</aligny>
                        <label>[UPPERCASE]$INFO[ListItem.Property(label2)][/UPPERCASE]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="90" width="1242">
                    <control type="image">
                        <animation effect="fade" start="100" end="50" time="0" condition="!Control.HasFocus(2100)">Conditional</animation>
                        <width>1242</width>
                        <texture colordiffuse="button_focus">special://skin/media/masks/focus.png</texture>
                    </control>
                    <control type="label">
                        <left>15</left>
                        <top>45</top>
                        <height>5</height>
                        <width max="360">auto</width>
                        <font>font12</font>
                        <!-- Finder_26 -->
                        <textcolor>focused_text</textcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                        <label>[UPPERCASE]$INFO[ListItem.Property(label1)][/UPPERCASE]</label>
                        <scroll>Control.HasFocus(2100)</scroll>
                    </control>
                    <control type="label">
                        <width max="782">auto</width>
                        <left>440</left>
                        <top>45</top>
                        <height>5</height>
                        <font>font12</font>
                        <!-- Finder_26 -->
                        <textcolor>focused_text</textcolor>
                        <align>right</align>
                        <aligny>center</aligny>
                        <label>[UPPERCASE]$INFO[ListItem.Property(label2)][/UPPERCASE]</label>
                        <scroll>Control.HasFocus(2100)</scroll>
                    </control>
                </focusedlayout>
            </control>
            <control type="scrollbar" id="4100">
                <top>65</top>
                <left>1277</left>
                <width>10</width>
                <height>720</height>
                <onleft>2100</onleft>
                <onright condition="String.IsEqual(Window.Property(active_attributes),true)">10</onright>
                <onright condition="!String.IsEqual(Window.Property(active_attributes),true)">11</onright>
                <texturesliderbackground colordiffuse="focused_text">finder_common/white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="dialog_bg2">finder_common/white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="unfocused_text">finder_common/white.png</texturesliderbarfocus>
                <showonepage>false</showonepage>
                <orientation>vertical</orientation>
            </control>
            <control type="group">
                <top>850</top>
                <left>15</left>
                <control type="label">
                    <top>10</top>
                    <left>30</left>
                    <width>1635</width>
                    <height>20</height>
                    <font>font12</font>
                    <!-- Finder_26 -->
                    <textcolor>unfocused_text</textcolor>
                    <label>[UPPERCASE]$INFO[Window.Property(list_label)][/UPPERCASE]</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <scroll>true</scroll>
                </control>
                <control type="label">
                    <top>45</top>
                    <left>30</left>
                    <width>1635</width>
                    <height>20</height>
                    <font>font10</font>
                    <!-- Finder_21 -->
                    <textcolor>unfocused_text</textcolor>
                    <label>[UPPERCASE][I]$INFO[Window.Property(url_label)][/I][/UPPERCASE]</label>
                    <align>center</align>
                    <aligny>center</aligny>
                    <scroll>true</scroll>
                </control>
            </control>
            <control type="group">
                <top>65</top>
                <left>1342</left>
                <control type="button" id="10">
                    <description>Save and Exit</description>
                    <width>340</width>
                    <height>85</height>
                    <onup>11</onup>
                    <ondown>11</ondown>
                    <onleft>2100</onleft>
                    <onright>2100</onright>
                    <label>Save and Exit</label>
                    <font>font12</font>
                    <!-- Finder_26 -->
                    <textcolor>unfocused_text</textcolor>
                    <focusedcolor>focused_text</focusedcolor>
                    <texturefocus colordiffuse="button_focus">special://skin/media/buttons/dfo.png</texturefocus>
                    <texturenofocus colordiffuse="button_focus2">special://skin/media/buttons/dnfo.png</texturenofocus>
                    <align>center</align>
                    <aligny>center</aligny>
                    <visible>String.IsEqual(Window.Property(active_attributes),true)</visible>
                </control>
                <control type="button" id="11">
                    <description>Exit</description>
                    <animation effect="slide" end="0,-95" time="0" condition="!String.IsEqual(Window.Property(active_attributes),true)">Conditional</animation>
                    <top>95</top>
                    <width>340</width>
                    <height>85</height>
                    <onup>10</onup>
                    <ondown>10</ondown>
                    <onleft>2100</onleft>
                    <onright>2100</onright>
                    <label>Exit</label>
                    <font>font12</font>
                    <!-- Finder_26 -->
                    <textcolor>unfocused_text</textcolor>
                    <focusedcolor>focused_text</focusedcolor>
                    <texturefocus colordiffuse="button_focus">special://skin/media/buttons/dfo.png</texturefocus>
                    <texturenofocus colordiffuse="button_focus2">special://skin/media/buttons/dnfo.png</texturenofocus>
                    <align>center</align>
                    <aligny>center</aligny>
                </control>
            </control>
        </control>
    </controls>
</window>
