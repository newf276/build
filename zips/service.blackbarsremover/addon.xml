<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.blackbarsremover" name="[B]Black Bars Remover[/B]" version="0.2.27" provider-name="newf276">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_gb">Automatically fit video to screen</summary>
        <description lang="en_gb">Automatically adjusts the zoomlevel to eliminate black bars in videos. This addon also respects Kodi's "minimise black bars" setting.</description>
		<disclaimer lang="en_GB">This Addon contains no content</disclaimer>
		<language>en</language>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
        <source>https://github.com/newf276/build/tree/master/zips</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
