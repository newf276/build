<addons>
<addon id="plugin.program.cleaner" name="[B][COLOR dodgerblue]Newf's[/COLOR] Wizard[/B]" version="1.0.0" provider-name="Slam, Sarge, Funsterbe, BYB, newf276">
	<requires>
		<import addon="xbmc.python" version="3.0.0"/>
		<import addon="script.module.requests" optional="true" />
	</requires>
	<extension point="xbmc.python.pluginsource" library="addon.py">
		<provides>executable</provides>
	</extension>
	<extension point="xbmc.service" library="service.py" />
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Newf's Wizard - Kodi's Swiss Army Knife</summary>
		<description lang="en_GB">Newf's Wizard is a lightweight template for installing builds on Kodi and clearing clutter from caches and temp files.</description>
		<disclaimer lang="en_GB">This Addon contains no content</disclaimer>
		<language>en</language>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
        <source>https://github.com/newf276/build/tree/master/zips</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>

