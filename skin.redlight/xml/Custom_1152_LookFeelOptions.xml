<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1152">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>420</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight4]" />
				<param name="header_label" value="Choose Look &amp; Feel" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<onback>Dialog.Close(1152)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Redlight.DirectDialog1152),true)">ActivateWindow(1170)</onback>
				<onback condition="String.IsEqual(Window(Home).Property(Redlight.DirectDialog1152),true)">ClearProperty(Redlight.DirectDialog1152,home)</onback>
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="280" />
				</include>
				<content>
					<item>
						<label>[COLOR FFC40300]Redlight Plus[/COLOR]</label>
						<onclick>Skin.SetString(Redlight.PendingLookFeel,redlightplus)</onclick>
						<onclick>Dialog.Close(1152)</onclick>
						<onclick>ActivateWindow(1153)</onclick>
					</item>
					<item>
						<label>[COLOR FFFF8A00]Redlight Hybrid[/COLOR]</label>
						<onclick>Skin.SetString(Redlight.PendingLookFeel,hybrid)</onclick>
						<onclick>Dialog.Close(1152)</onclick>
						<onclick>ActivateWindow(1153)</onclick>
					</item>
					<item>
						<label>[COLOR FFEAECED]Classic Redlight[/COLOR]</label>
						<onclick>Skin.SetString(Redlight.PendingLookFeel,classic)</onclick>
						<onclick>Dialog.Close(1152)</onclick>
						<onclick>ActivateWindow(1153)</onclick>
					</item>
					<item>
						<label>[COLOR FF12A0C7]Default Estuary[/COLOR]</label>
						<onclick>Skin.SetString(Redlight.PendingLookFeel,estuary)</onclick>
						<onclick>Dialog.Close(1152)</onclick>
						<onclick>ActivateWindow(1153)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
