<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1153">
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<onunload>Skin.Reset(Redlight.PendingLookFeel)</onunload>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>280</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="$VAR[DialogHeight1-2]" />
				<param name="header_label" value="Choose Artwork" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include content="ButtonMenuList_dialog">
					<param name="panel_height" value="140" />
				</include>
				<onback>Dialog.Close(1153)</onback>
				<onback>ActivateWindow(1152)</onback>
				<content>
					<item>
						<label>Default Artwork</label>
						<onclick condition="String.IsEqual(Skin.String(Redlight.PendingLookFeel),redlightplus)">RunScript(script.redlight.helper,mode=apply_lookfeel&amp;lookfeel=redlightplus&amp;keep_artwork=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Redlight.PendingLookFeel),hybrid)">RunScript(script.redlight.helper,mode=apply_lookfeel&amp;lookfeel=hybrid&amp;keep_artwork=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Redlight.PendingLookFeel),classic)">RunScript(script.redlight.helper,mode=apply_lookfeel&amp;lookfeel=classic&amp;keep_artwork=false)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Redlight.PendingLookFeel),estuary)">RunScript(script.redlight.helper,mode=apply_lookfeel&amp;lookfeel=estuary&amp;keep_artwork=false)</onclick>
						<onclick>ClearProperty(Redlight.DirectDialog1152,home)</onclick>
						<onclick>Dialog.Close(1153)</onclick>
					</item>
					<item>
						<label>Keep Current Artwork</label>
						<onclick condition="String.IsEqual(Skin.String(Redlight.PendingLookFeel),redlightplus)">RunScript(script.redlight.helper,mode=apply_lookfeel&amp;lookfeel=redlightplus&amp;keep_artwork=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Redlight.PendingLookFeel),hybrid)">RunScript(script.redlight.helper,mode=apply_lookfeel&amp;lookfeel=hybrid&amp;keep_artwork=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Redlight.PendingLookFeel),classic)">RunScript(script.redlight.helper,mode=apply_lookfeel&amp;lookfeel=classic&amp;keep_artwork=true)</onclick>
						<onclick condition="String.IsEqual(Skin.String(Redlight.PendingLookFeel),estuary)">RunScript(script.redlight.helper,mode=apply_lookfeel&amp;lookfeel=estuary&amp;keep_artwork=true)</onclick>
						<onclick>ClearProperty(Redlight.DirectDialog1152,home)</onclick>
						<onclick>Dialog.Close(1153)</onclick>
					</item>
				</content>
			</control>
		</control>
	</controls>
</window>
