<?xml version='1.0' encoding='UTF-8'?>
<window>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="80000000">finder_common/white.png</texture>
        </control>
        <control type="group">
            <left>100</left>
            <top>135</top>
            <control type="image">
                <height>812</height>
                <width>1722</width>
                <texture colordiffuse="unfocused_text">special://skin/media/masks/landscape-502.png</texture>
                <left>-2</left>
                <top>-2</top>
            </control>
            <control type="image">
                <height>808</height>
                <width>1718</width>
                <texture colordiffuse="dialog_bg">special://skin/media/masks/landscape-502.png</texture>
            </control>
            <control type="image">
                <description>Kodi corner icon</description>
                <left>1640</left>
                <top>25</top>
                <width>48</width>
                <height>48</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="accent_color">special://xbmc/media/vendor_icon.png</texture>
            </control>
            <control type="group">
                <control type="image">
                    <left>1170</left>
                    <top>10</top>
                    <height max="792">auto</height>
                    <width max="530">auto</width>
                    <align>left</align>
                    <aspectratio aligny="top">keep</aspectratio>
                    <texture diffuse="finder_diffuse/poster-50.png" background="true">$INFO[Window.Property(poster)]</texture>
                </control>
                <control type="textbox" id="2001">
                    <top>50</top>
                    <left>20</left>
                    <width>1100</width>
                    <height>690</height>
                    <font>font14</font>
                    <!-- Finder_33 -->
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>unfocused_text</textcolor>
                    <pagecontrol>2099</pagecontrol>
                    <autoscroll>false</autoscroll>
                </control>
                <control type="scrollbar" id="2099">
                    <left>1140</left>
                    <top>35</top>
                    <width>10</width>
                    <height>740</height>
                    <texturesliderbackground colordiffuse="focused_text">finder_common/white.png</texturesliderbackground>
                    <texturesliderbar colordiffuse="dialog_bg2">finder_common/white.png</texturesliderbar>
                    <texturesliderbarfocus colordiffuse="unfocused_text">finder_common/white.png</texturesliderbarfocus>
                    <onleft>2099</onleft>
                    <onright>2099</onright>
                    <showonepage>false</showonepage>
                    <orientation>vertical</orientation>
                </control>
            </control>
            <control type="group">
                <control type="image">
                    <top>380</top>
                    <left>-70</left>
                    <width>50</width>
                    <height>50</height>
                    <texture colordiffuse="unfocused_text" background="true">finder_common/arrow_left.png</texture>
                    <visible>String.IsEqual(Window.Property(previous_display),true)</visible>
                </control>
                <control type="image">
                    <top>380</top>
                    <left>1740</left>
                    <width>50</width>
                    <height>50</height>
                    <texture colordiffuse="unfocused_text" background="true" flipx="true">finder_common/arrow_left.png</texture>
                    <visible>String.IsEqual(Window.Property(next_display),true)</visible>
                </control>
            </control>
        </control>
    </controls>
</window>
